# Set strong unique secrets before starting. Do not commit your real .env.
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MRA_DB_DATABASE=db_mra
MRA_DB_USER=mra_user
MRA_DB_PASSWORD=replace_with_a_strong_database_password
ADMIN_SETUP_KEY=replace_with_a_long_random_setup_key
SESSION_SECRET=replace_with_at_least_64_random_characters

# Optional: real HOSxP/HIS connection. The app container must be able to reach this host.
HIS_DB_HOST=host.docker.internal
HIS_DB_PORT=3306
HIS_DB_DATABASE=hos
HIS_DB_USER=
HIS_DB_PASSWORD=
